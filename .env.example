# Environment variable template
# Copy this file to .env and fill in real values.
# Never commit .env to version control.

# ── Optional: Override default dataset root ──────────────────────────────────
# SEMIMIND_DATA_ROOT=datasets

# ── Optional: Database connection (for later phases) ─────────────────────────
# DATABASE_URL=postgresql://user:password@localhost:5432/semimind

# ── Optional: Snowflake credentials (Phase 6+) ───────────────────────────────
# SNOWFLAKE_ACCOUNT=
# SNOWFLAKE_USER=
# SNOWFLAKE_PASSWORD=
# SNOWFLAKE_DATABASE=
# SNOWFLAKE_SCHEMA=
# SNOWFLAKE_WAREHOUSE=
# SNOWFLAKE_ROLE=

# ── Optional: Azure credentials (Phase 7+) ───────────────────────────────────
# AZURE_SUBSCRIPTION_ID=
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=

# ── Optional: Log level override ─────────────────────────────────────────────
# LOG_LEVEL=INFO
